{
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/(.*)",
      "destination": "/app/$1"
    },
    {
      "source": "/students",
      "destination": "/students/index.html"
    },
    {
      "source": "/students/(.*)",
      "destination": "/students/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}